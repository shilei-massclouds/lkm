#!/usr/bin/env python3
"""Run tools2 Python tests without a caller-maintained PYTHONPATH."""

from __future__ import annotations

from pathlib import Path
import sys
import unittest


TOOLS2_ROOT = Path(__file__).resolve().parents[1]
REPOSITORY_ROOT = TOOLS2_ROOT.parent


def main(argv: list[str] | None = None) -> None:
    repository = str(REPOSITORY_ROOT)
    if repository not in sys.path:
        sys.path.insert(0, repository)

    # Importing the test package discovers every independent tools2 source package.
    import tools2.tests  # noqa: F401

    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments:
        arguments = [
            "discover",
            "-s",
            str(TOOLS2_ROOT / "tests"),
            "-t",
            str(REPOSITORY_ROOT),
            "-v",
        ]
    unittest.main(module=None, argv=[sys.argv[0], *arguments])


if __name__ == "__main__":
    main()
