#!/usr/bin/env python3
"""Repository-relative convenience entry for the tools2 Signal driver."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


TOOLS2_ROOT = Path(__file__).resolve().parents[1]
REPOSITORY_ROOT = TOOLS2_ROOT.parent
DEFAULT_SPEC = REPOSITORY_ROOT / "spec" / "model" / "main.spec"
DEFAULT_TRIGGER = "Computer.Preset"
SCENARIOS_ROOT = TOOLS2_ROOT / "scenarios"


def _bootstrap() -> None:
    for name in (
        "common",
        "parse",
        "model",
        "derive",
        "check",
        "view",
        "render",
        "animate",
        "pyveri",
    ):
        source = str(TOOLS2_ROOT / name / "src")
        if source not in sys.path:
            sys.path.insert(0, source)


def _parser(normalize_signal_request) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tools2/bin/pyveri",
        description="Run the tools2 Signal pipeline.",
    )
    parser.add_argument(
        "-t",
        "--trigger",
        type=lambda value: normalize_signal_request(value, option="--trigger"),
        metavar="SIGNAL",
        help="Signal trigger as Target.SignalName; default: Computer.Startup",
    )
    parser.add_argument(
        "-u",
        "--until",
        type=lambda value: normalize_signal_request(value, option="--until"),
        metavar="SIGNAL",
        help="stop immediately before sending Target.SignalName",
    )
    parser.add_argument("-s", "--scenario", type=Path, help="scenario or tools2 snapshot JSON")
    parser.add_argument(
        "-f",
        "--spec",
        type=Path,
        default=DEFAULT_SPEC,
        help="input .spec file; default: spec/model/main.spec",
    )
    parser.add_argument("--source", default="Human", help="Signal source; default: Human")
    parser.add_argument("--max-depth", default="all", metavar="N|all")
    parser.add_argument("--max-breadth", default="all", metavar="N|all")
    parser.add_argument("--work-dir", type=Path, help="retain stage JSON in this directory")
    parser.add_argument(
        "--snapshot-out", type=Path, help="write a resumable snapshot on complete or reached"
    )
    parser.add_argument("-o", "--output", type=Path, help="write rendered text instead of stdout")
    parser.add_argument("--html-out", type=Path, help="write a self-contained Signal animation")
    return parser


def main(argv: list[str] | None = None) -> int:
    _bootstrap()
    from tools2_common import normalize_signal_request

    args = _parser(normalize_signal_request).parse_args(argv)
    trigger = args.trigger
    scenario = args.scenario
    if args.trigger is not None and scenario is None:
        scenario_root = SCENARIOS_ROOT.resolve()
        assert trigger is not None
        expected = SCENARIOS_ROOT / f"{trigger}.snapshot.json"
        candidate = expected.resolve()
        try:
            candidate.relative_to(scenario_root)
        except ValueError:
            print(
                f"tools2/bin/pyveri: unsafe default scenario for canonical signal "
                f"{trigger}: expected path {expected}",
                file=sys.stderr,
            )
            return 2
        if not candidate.is_file():
            print(
                f"tools2/bin/pyveri: no default scenario for canonical signal "
                f"{trigger}: expected path {expected}",
                file=sys.stderr,
            )
            return 2
        scenario = candidate
    from pyveri.__main__ import main as driver_main

    driver_args = [
        str(args.spec),
        "--source",
        args.source,
        "--max-depth",
        args.max_depth,
        "--max-breadth",
        args.max_breadth,
    ]
    if trigger is not None:
        driver_args.extend(["--signal", trigger])
    if scenario is not None:
        driver_args.extend(["--scenario", str(scenario)])
    if args.until is not None:
        driver_args.extend(["--until", args.until])
    if args.work_dir is not None:
        driver_args.extend(["--work-dir", str(args.work_dir)])
    if args.snapshot_out is not None:
        driver_args.extend(["--snapshot-out", str(args.snapshot_out)])
    if args.output is not None:
        driver_args.extend(["-o", str(args.output)])
    if args.html_out is not None:
        driver_args.extend(["--html-out", str(args.html_out)])
    return driver_main(driver_args)


if __name__ == "__main__":
    raise SystemExit(main())
